GROQ_API_KEY=your_groq_api_key_here
CHAT_MODEL=openai/gpt-oss-120b
CHAT_MODEL_FALLBACKS=groq/compound,openai/gpt-oss-20b,qwen/qwen3.6-27b

# Brand and personality customization
WEBSITE_NAME=Your Website Name
BUSINESS_DOMAIN=products, pricing, support, and onboarding
BRAND_VOICE=professional, warm, and concise
KNOWLEDGE_BASE_SNIPPET=Paste short business facts, FAQs, and policies here.

# Conversation memory window
CHAT_HISTORY_WINDOW=10

# Use comma-separated origins in production, example:
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=*
